# Nurse Task Management System - Environment Variables
SECRET_KEY=hospital-nurse-task-secret-key-2026

# Database configuration
# Set DB_TYPE to 'mysql' to connect to MySQL Server, or 'sqlite' for zero-config file DB
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=nurse_task_db

# SQLite database file path (used if DB_TYPE=sqlite or as automatic fallback)
SQLITE_DB_PATH=nurse_task.db
